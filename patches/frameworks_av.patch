diff --git a/services/mediacodec/Android.bp b/services/mediacodec/Android.bp
index bf4d524..0c97961 100644
--- a/services/mediacodec/Android.bp
+++ b/services/mediacodec/Android.bp
@@ -155,3 +155,32 @@ prebuilt_etc {
         "code_coverage.policy",
     ],
 }
+
+// ATU-L21: the 8.0 vendor OMX service links Android 8.0 system libraries (libmediacodecservice etc.) and
+// does not start on Android 12. System variant built from the same source; it loads the Qualcomm
+// hardware codec plugin (/vendor/lib/libstagefrighthw.so). No software OMX codecs (Codec2 provides them).
+cc_binary {
+    name: "atu_omx_service",
+    stem: "android.hardware.media.omx@1.0-service",
+    relative_install_path: "hw",
+    srcs: ["main_codecservice.cpp"],
+    shared_libs: [
+        "libbinder",
+        "libutils",
+        "liblog",
+        "libbase",
+        "libavservices_minijail",
+        "libcutils",
+        "libhidlbase",
+        "libstagefright_omx",
+        "libstagefright_xmlparser",
+        "android.hardware.media.omx@1.0",
+        "android.hidl.memory@1.0",
+    ],
+    compile_multilib: "32",
+    cflags: [
+        "-Werror",
+        "-Wall",
+        "-Wno-error=deprecated-declarations",
+    ],
+}

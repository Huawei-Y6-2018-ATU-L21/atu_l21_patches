+// ATU-L21 debug: there is no pstore/last_kmsg, so when init hits a fatal error the kernel
+// log to persistent storage. Order: already mounted /cache, /data, and as a last resort
+// mounting the cache partition (mmcblk0p45) ourselves (only works before SELinux is loaded).
+static bool WriteKmsgTo(const std::string& dir, const std::string& buf,
+                        const char* prefix = "kmsg", bool quiet = false) {
+    mkdir(dir.c_str(), 0755);
+    std::string boot_id;
+    android::base::ReadFileToString("/proc/sys/kernel/random/boot_id", &boot_id);
+    boot_id = android::base::Trim(boot_id);
+    if (boot_id.empty()) boot_id = "unknown";
+    std::string out = dir + "/" + prefix + "-" + boot_id + ".txt";
+    if (!android::base::WriteStringToFile(buf, out)) return false;
+    sync();
+    if (!quiet) LOG(ERROR) << "ATU: kmsg written: " << out;
+    return true;
+}
+
+// ATU-L21 debug: so that a trace remains even if boot hangs (without a fatal), every 20 s
+// writes kmsg and the process list (/proc/<pid>/cmdline, state, wchan) to the mounted /cache.
+static std::string ProcSnapshot() {
+    std::string out;
+    std::unique_ptr<DIR, decltype(&closedir)> d(opendir("/proc"), closedir);
+    if (!d) return out;
+    dirent* e;
+    while ((e = readdir(d.get()))) {
+        if (e->d_name[0] < '0' || e->d_name[0] > '9') continue;
+        std::string base = std::string("/proc/") + e->d_name;
+        std::string cmd, stat, wchan, ctx;
+        android::base::ReadFileToString(base + "/cmdline", &cmd);
+        std::replace(cmd.begin(), cmd.end(), '\0', ' ');
+        android::base::ReadFileToString(base + "/stat", &stat);
+        android::base::ReadFileToString(base + "/wchan", &wchan);
+        android::base::ReadFileToString(base + "/attr/current", &ctx);
+        ctx = android::base::Trim(ctx);
+        // stat: "pid (comm) S ..." -> first 3 fields only
+        auto p = stat.find(')');
+        std::string head = p == std::string::npos ? stat : stat.substr(0, std::min(stat.size(), p + 3));
+        out += head + " | " + wchan + " | " + ctx + " | " + cmd + "\n";
+    }
+    return out;
+}
+
+void StartAtuDebugWatcher() {
+    std::thread([] {
+        for (int i = 0; i < 300; i++) {
+            sleep(i < 20 ? 3 : 20);  // every 3 s for the first ~1 min, then every 20 s
+            if (access("/cache/lost+found", F_OK) != 0) {
+                // /cache is not mounted yet: mount it ourselves with init's normal permissions.
+                const char* dev = "/dev/block/bootdevice/by-name/cache";
+                if (access(dev, F_OK) != 0) dev = "/dev/block/by-name/cache";
+                if (mount(dev, "/cache", "ext4", MS_NOATIME | MS_NODEV | MS_NOSUID, "") != 0) {
+                    continue;
+                }
+                LOG(ERROR) << "ATU: watcher /cache'i kendisi mount etti";
+            }
+            int size = klogctl(10, nullptr, 0);
+            if (size <= 0) size = 1 << 20;
+            std::string buf(size, '\0');
+            int n = klogctl(3, buf.data(), size);
+            if (n > 0) {
+                buf.resize(n);
+                WriteKmsgTo("/cache/init-fatal", buf, "watch-kmsg", true);
+            }
+            WriteKmsgTo("/cache/init-fatal", ProcSnapshot(), "watch-ps", true);
+        }
+    }).detach();
+}
+
+static void DumpKmsgToCache() {
+    int size = klogctl(10 /* SYSLOG_ACTION_SIZE_BUFFER */, nullptr, 0);
+    if (size <= 0) size = 1 << 20;
+    std::string buf(size, '\0');
+    int n = klogctl(3 /* SYSLOG_ACTION_READ_ALL */, buf.data(), size);
+    if (n <= 0) return;
+    buf.resize(n);
+
+    if (access("/cache/lost+found", F_OK) == 0 && WriteKmsgTo("/cache/init-fatal", buf)) return;
+    if (access("/data/unencrypted", F_OK) == 0 && WriteKmsgTo("/data/init-fatal", buf)) return;
+
+    std::string devnum;
+    if (!android::base::ReadFileToString("/sys/class/block/mmcblk0p45/dev", &devnum)) return;
+    unsigned int maj = 0, min = 0;
+    if (sscanf(devnum.c_str(), "%u:%u", &maj, &min) != 2) return;
+    const char* blk = "/dev/__atu_cache_blk";
+    const char* mnt = "/dev/__atu_cache";
+    unlink(blk);
+    if (mknod(blk, S_IFBLK | 0600, makedev(maj, min)) != 0) return;
+    mkdir(mnt, 0700);
+    if (mount(blk, mnt, "ext4", MS_NOATIME | MS_NODEV | MS_NOSUID, "") != 0) return;
+    WriteKmsgTo(std::string(mnt) + "/init-fatal", buf);
+    umount(mnt);
+}

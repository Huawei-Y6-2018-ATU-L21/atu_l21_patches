@@ -0,0 +1,33 @@
+// ATU-L21: cutils thread_store API removed in Android 11. Needed by Android 8.0 vendor processes
+// the Android 9 libbinder.so used there (Parcel memory layout compat) needs these functions.
+#include <pthread.h>
+#include <stddef.h>
+
+extern "C" {
+typedef struct {
+    pthread_mutex_t lock;
+    int has_tls;
+    pthread_key_t tls;
+} thread_store_t;
+
+typedef void (*thread_store_destruct_t)(void* value);
+
+__attribute__((visibility("default"))) void* thread_store_get(thread_store_t* store) {
+    if (!store->has_tls) return nullptr;
+    return pthread_getspecific(store->tls);
+}
+
+__attribute__((visibility("default"))) void thread_store_set(thread_store_t* store, void* value,
+                                                             thread_store_destruct_t destroy) {
+    pthread_mutex_lock(&store->lock);
+    if (!store->has_tls) {
+        if (pthread_key_create(&store->tls, destroy) != 0) {
+            pthread_mutex_unlock(&store->lock);
+            return;
+        }
+        store->has_tls = 1;
+    }
+    pthread_mutex_unlock(&store->lock);
+    pthread_setspecific(store->tls, value);
+}
+}

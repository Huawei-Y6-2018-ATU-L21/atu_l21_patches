@@ -130,6 +130,18 @@ void LoadLibraryListVariables(const std::string& root) {
   auto sanitizer_library_path = root + "/system/etc/sanitizer.libraries.txt";
   Variables::AddValue("SANITIZER_RUNTIME_LIBRARIES",
                       GetLibrariesString(sanitizer_library_path));
+
+  // ATU-L21: a VNDK-less (Android 8.0) vendor has no VNDK APEX; list variables are not loaded and
+  // APEX configs abort with "undefined var". Define the missing ones as empty.
+  for (const std::string partition : {"VENDOR", "PRODUCT"}) {
+    for (const std::string prefix :
+         {"LLNDK_LIBRARIES_", "PRIVATE_LLNDK_LIBRARIES_", "VNDK_SAMEPROCESS_LIBRARIES_",
+          "VNDK_CORE_LIBRARIES_", "SANITIZER_DEFAULT_"}) {
+      if (!Variables::GetValue(prefix + partition).has_value()) {
+        Variables::AddValue(prefix + partition, "");
+      }
+    }
+  }
 }
 }  // namespace
 

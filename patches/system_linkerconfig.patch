diff --git a/contents/section/legacy.cc b/contents/section/legacy.cc
index 0a53a13..2acc85b 100644
--- a/contents/section/legacy.cc
+++ b/contents/section/legacy.cc
@@ -44,6 +44,26 @@ Section BuildLegacySection(Context& ctx) {
 
   return BuildSection(ctx, "legacy", std::move(namespaces), visible_apexes);
 }
+
+// ATU-L21: copy of the legacy section for Android 8.0 vendor binaries; old-ABI compat
+// libraries (e.g. Android 9 protobuf) are loaded from /system/${LIB}/atu-compat before system ones.
+Section BuildLegacyVendorSection(Context& ctx) {
+  ctx.SetCurrentSection(SectionType::System);
+  std::vector<Namespace> namespaces;
+
+  auto ns = BuildSystemDefaultNamespace(ctx);
+  ns.PrependSearchPath("/system/${LIB}/atu-compat");
+  namespaces.emplace_back(std::move(ns));
+
+  std::set<std::string> visible_apexes;
+  for (const auto& apex : ctx.GetApexModules()) {
+    if (apex.jni_libs.size() > 0 || apex.public_libs.size() > 0) {
+      visible_apexes.insert(apex.name);
+    }
+  }
+
+  return BuildSection(ctx, "legacy_vendor", std::move(namespaces), visible_apexes);
+}
 }  // namespace contents
 }  // namespace linkerconfig
 }  // namespace android
diff --git a/generator/variableloader.cc b/generator/variableloader.cc
